<% layout("/layouts/boilerplate.ejs")%>
<body>
    
<div class="row">
    <div class="col-8 offset-2 mt-10">
<div class="card col-8 offset-2 planting-card">
    <h3>Planting Details: </h3>
     <img src="<%= planting.image.url %>" class="card-img-top show-img" alt="planting_image" />
    <p class="card-text">
       <b><li><%=planting.title%></li></b>
        <li><%=planting.description%></li>
        <li><%=planting.price%></li>
        <li><%=planting.location%></li>
        <li><%=planting.country%></li>
    </p>
    
</div>
<div class="btns">
<a href="/plantings/<%=planting._id%>/edit" class="btn btn-dark col-2 offset-2">Edit</a>
 

<form method="POST" action="/plantings/<%=planting._id%>?_method=DELETE">
    <button class="btn btn-dark offset-2">Delete</button>
</form>
</div>

<!-- //add to cart  -->
<div class="mt-2">
<form method="POST" action="/cart/<%=planting._id%>">
    <button class="btn btn-success offset-2">Add to Cart</button>
</form>
</div>
<!-- //reivew section -->
<hr>
<div class="col-10 offset-2 mb-3">
<h4>Leave a Review</h4>
<form action="/plantings/<%=planting._id%>/reviews" method="POST" novalidate class="needs-validation">

    <!-- starability -->
  <div class="mb-3 mt-3">
    <label for="rating" class="form-label">Rating</label>
<fieldset class="starability-slot">

  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="second-rate1" name="review[rating]" value="1" />
  <label for="second-rate1" title="Terrible">1 star</label>
  <input type="radio" id="second-rate2" name="review[rating]" value="2" />
  <label for="second-rate2" title="Not good">2 stars</label>
  <input type="radio" id="second-rate3" name="review[rating]" value="3" />
  <label for="second-rate3" title="Average">3 stars</label>
  <input type="radio" id="second-rate4" name="review[rating]" value="4" />
  <label for="second-rate4" title="Very good">4 stars</label>
  <input type="radio" id="second-rate5" name="review[rating]" value="5" />
  <label for="second-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>

    <div>
        <label for="comment" class="form-label" >Comments</label>
        <textarea name="review[comment]" cols="30" rows="10" id="comment" class="form-control" required></textarea>
        <div class="invalid-feedback">Please submit some comments for review</div>
    </div>
    <button class="btn btn-outline-dark mt-3">Submit</button>
</form>
<p><b>All Reviews</b></p>
<div class="row">
<% for(review of planting.reviews){%>
<div class="card col-lg-5 ms-2 mb-3">
<div class="card-body">
    <h5 class="card-title">Maryam</h5>
    <p class="card-text"><%= review.comment%></p>
    <p class="starability-result card-text mb-3" data-rating="<%= review.rating%>"></p>
</div>
<form class="mb-3" method="POST" action="/plantings/<%=planting._id%>/reviews/<%=review._id%>?_method=DELETE">
    <button class="btn btn-sm btn-dark">Delete</button>
</form>
</div>
    <%} %>
    </div>
</div>
</body>
