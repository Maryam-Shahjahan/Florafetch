<% layout("/layouts/boilerplate.ejs")%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
    <h3>Create a new Plant Listings</h3>
    <form method="POST" action="/plantings" novalidate
     class="needs-validation" 
     enctype="multipart/form-data">

        <div>
        <label for="title" class="form-label">Title</label>
        <input name="planting[title]" placeholder="enter title" class="form-control"required>
        </div>

        <div>
        <label for="description" class="form-label">Description</label>
         <textarea name="planting[description]" placeholder="enter description" type="text" class="form-control" required></textarea>
        </div>

        <div>
        <label for="image" class="form-label">Upload Planting Image</label>
         <input name="planting[image]" type="file" class="form-control" required>
        </div>


        <div class="row mt-3">
        <div class="mb-3 col-lg-4 col-md-8">
        <label for="price" class="form-label">Price</label>
        <input name="planting[price]" placeholder="enter price" type="number" class="form-control" required>
        </div>

        <div class="mb-3 col-lg-4 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input name="planting[country]" placeholder="enter country name" type="text" class="form-control" required>
        </div>
        </div>

        <div>
        <label for="location" class="form-label">Location</label>
        <input name="planting[location]" placeholder="enter location" type="text" class="form-control" required>
        </div>
        <br>
        <button class="btn btn-success">Add</button>
    </form>
    </div>
    </div>
</body>
