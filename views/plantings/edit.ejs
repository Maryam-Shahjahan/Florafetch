<% layout("/layouts/boilerplate.ejs")%>
<body>
    <div class="row">
    <div class="col-8 offset-2">
    <h3>Edit the details in Planting</h3>
    <form method="POST" action="/plantings/<%=planting._id%>?_method=PUT" novalidate class="needs-validation">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
        <input name="planting[title]" value="<%=planting.title%>" class="form-control" required>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
         <textarea name="planting[description]" type="text" class="form-control" required><%= planting.description%> </textarea>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
         <input name="planting[image]" value="<%= planting.image%>" type="text" class="form-control" required>
        </div>

        <div class="row">
        <div class="mb-3 col-md-4 col-sm-12">
            <label for="price" class="form-label">Price</label>
        <input name="planting[price]" value="<%= planting.price%>" type="number" class="form-control" required>
        </div>

        <div class="mb-3 col-md-4 col-sm-12">
            <label for="country" class="form-label">Country</label>
        <input name="planting[country]"  value="<%=planting.country%>"type="text" class="form-control" required>
        </div>
         </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
        <input name="planting[location]" value="<%=planting.location%>" type="text" class="form-control" required>
        
        <button class="btn btn-success mt-3">Edit</button>
    </form>
    </div>
    </div>
</body>
